diff --git a/crates/horizon-threads/src/ios_multitouch.rs b/crates/horizon-threads/src/ios_multitouch.rs
new file mode 100644
index 0000000..352bf68
--- /dev/null
+++ b/crates/horizon-threads/src/ios_multitouch.rs
@@ -0,0 +1,25 @@
+//! More than one finger at a time on a touch screen: the OS call the other crates, which
+//! forbid unsafe code, cannot make themselves.
+//!
+//! `UIView.multipleTouchEnabled` is off by default, and the view winit makes for its iOS
+//! window leaves it that way: the first finger down owns the view's touches and a second one
+//! is never delivered. Someone holding the stick and turning the view with another finger
+//! then loses the stick the moment the second finger lands, which reads as the player
+//! stopping while the view turns.
+//!
+//! It is one flag on the view, so it is set here rather than in a patch to winit.
+
+/// Let the window's view report every finger. `view` is the `UIView` behind the window: a
+/// `winit` iOS window's `RawWindowHandle::UiKit(...).ui_view`.
+///
+/// Safe to call with any pointer, as a message to an object that is not live is the call this
+/// crate exists to make and not a use of the pointer after free: the caller passes the view of
+/// a window it holds.
+pub fn set_multiple_touch_enabled(view: *mut core::ffi::c_void) {
+    // SAFETY: `view` is the `UIView` of a window the caller holds; messaging it cannot outlive
+    // the window it belongs to.
+    let view: *mut objc2::runtime::AnyObject = view.cast();
+    unsafe {
+        let _: () = objc2::msg_send![view, setMultipleTouchEnabled: true];
+    }
+}
