diff --git a/crates/horizon-client/src/game/ios_multitouch.rs b/crates/horizon-client/src/game/ios_multitouch.rs
new file mode 100644
index 0000000..e4c0534
--- /dev/null
+++ b/crates/horizon-client/src/game/ios_multitouch.rs
@@ -0,0 +1,28 @@
+//! More than one finger at a time, on a touch screen.
+//!
+//! `UIView.multipleTouchEnabled` is off by default, and the view winit makes for its iOS
+//! window leaves it that way: the first finger down owns the view's touches, and a second
+//! one is not delivered at all. A person holding the stick and turning the view with another
+//! finger then loses the stick the moment the second finger lands, which reads as the player
+//! stopping while the view turns.
+//!
+//! It is one flag on the view. The view comes out of the window handle; the flag is set in
+//! `horizon_threads`, which may make the unsafe call this crate may not.
+
+use winit::window::Window;
+
+/// Let the window's view report every finger.
+pub(super) fn enable(window: &Window) {
+    use raw_window_handle::{HasWindowHandle, RawWindowHandle};
+    let Ok(handle) = window.window_handle() else {
+        log::warn!("iOS: no window handle, single touch only");
+        return;
+    };
+    let RawWindowHandle::UiKit(uikit) = handle.as_raw() else {
+        log::warn!("iOS: window handle is not UIKit, single touch only");
+        return;
+    };
+    // The call itself is `horizon_threads`': this crate forbids unsafe code.
+    horizon_threads::ios_multitouch::set_multiple_touch_enabled(uikit.ui_view.as_ptr());
+    log::info!("iOS: multiple touch enabled on the window's view");
+}
diff --git a/crates/horizon-client/src/game/ios_touch.rs b/crates/horizon-client/src/game/ios_touch.rs
new file mode 100644
index 0000000..e98e89c
--- /dev/null
+++ b/crates/horizon-client/src/game/ios_touch.rs
@@ -0,0 +1,529 @@
+//! Touch, on iOS: the stick, the look area and the buttons of `touch_hud`
+//! turned into the key and mouse holds a keyboard and a mouse would make.
+//! Bedrock is touch-first; this is the same idea on top of the desktop client's
+//! input, so every screen (chat, the inventory, a book) keeps working through
+//! the keys it already listens for.
+//!
+//! The controls only take over while playing: in a menu a tap stays a click,
+//! which is what the touch-to-pointer mapping in `window_handler` gives.
+use super::*;
+use winit::event::TouchPhase;
+use horizon_client_input::held::Source;
+use horizon_client_render::touch_hud::{self, Button, Layout};
+use std::sync::{Mutex, OnceLock};
+
+/// What the fingers are doing right now.
+#[derive(Default)]
+struct Touch {
+    /// The layout of the frame the touches are tested against.
+    layout: Option<Layout>,
+    /// The finger on the stick, and where it landed.
+    stick: Option<u64>,
+    origin: (f32, f32),
+    /// The finger turning the view, and where it was last seen.
+    look: Option<u64>,
+    last: (f32, f32),
+    /// The buttons held down, by the finger holding them.
+    held: Vec<(u64, Button)>,
+    /// Buttons whose finger has just lifted, held a moment longer: a tap hands
+    /// us Started and Ended in the same millisecond, so the frame that reads
+    /// the button would never see it down. Kept until the deadline passes.
+    latched: Vec<(Button, std::time::Instant)>,
+    /// Where the last finger went down, in GUI units, for the ruler's mark.
+    mark: Option<(f32, f32)>,
+    /// Where the stick's knob sits, in GUI units.
+    knob: (f32, f32),
+    /// Drag motion a finger has reported but the view has not turned by yet,
+    /// in window pixels: a touch reports its motion in bursts and a burst
+    /// handed over whole is a lurch.
+    pending: (f64, f64),
+    /// The controls are picked up by hand: a finger on one drags it, and letting
+    /// go writes the file.
+    edit: bool,
+    /// The ruler is drawn, so a person can read the shares off the screen.
+    debug: bool,
+    /// A finger that is holding mine or place and has slid: it keeps the button
+    /// down and turns the view with the same finger, which is how mining and
+    /// building are done with a thumb.
+    slide: Option<(u64, touch_hud::Handle, (f32, f32))>,
+    /// The control the finger is moving right now.
+    drag: Option<touch_hud::Handle>,
+}
+
+/// How long a tapped button stays down after the finger lifts, so the frame
+/// that reads input always sees a tap.
+const LATCH: std::time::Duration = std::time::Duration::from_millis(90);
+
+/// A finger drag has to turn the view as far as a mouse moved the same distance
+/// would, and a thumb has less room than a desk has: the drag is stretched the
+/// way the mobile ports this was checked against stretch theirs.
+const LOOK_GAIN: f64 = 1.6;
+
+/// The file a person edits to move the controls: `Documents/touch_layout.json`, which is in
+/// the Files app because the app shares its Documents folder.
+fn layout_file() -> Option<std::path::PathBuf> {
+    let home = std::env::var_os("HOME")?;
+    Some(std::path::PathBuf::from(home).join("Documents").join(touch_hud::FILE))
+}
+
+/// Writes the layout back, so a control dragged into place is still there after a restart.
+fn write_layout(layout: &Layout) {
+    let Some(path) = layout_file() else {
+        return;
+    };
+    if let Err(error) = std::fs::write(&path, layout.file()) {
+        log::warn!("Horizon: touch layout {}: {error}", path.display());
+    }
+}
+
+/// The layout a person edited, re-read when the file changes and written out in full the
+/// first time so its format is there to copy rather than to guess.
+#[cfg_attr(not(target_os = "ios"), allow(dead_code))]
+fn custom_layout(width: f32, height: f32) -> Option<touch_hud::Custom> {
+    static CACHE: OnceLock<Mutex<Cached>> = OnceLock::new();
+    let path = layout_file()?;
+    let cache = CACHE.get_or_init(|| Mutex::new(Cached::default()));
+    let mut held = cache.lock().unwrap_or_else(|poison| poison.into_inner());
+    // A drag reports motion at the display's rate; the file is looked at once a second.
+    let fresh = held.checked.is_some_and(|at| at.elapsed() < std::time::Duration::from_secs(1));
+    let stamp = if fresh {
+        held.stamp
+    } else {
+        held.checked = Some(std::time::Instant::now());
+        std::fs::metadata(&path).and_then(|meta| meta.modified()).ok()
+    };
+    if stamp.is_some() && held.stamp == stamp {
+        return held.custom.clone();
+    }
+    let custom = match std::fs::read_to_string(&path) {
+        Ok(text) => match serde_json::from_str::<touch_hud::Custom>(&text) {
+            Ok(custom) => {
+                log::info!("Horizon: touch layout read from {}", path.display());
+                Some(custom)
+            }
+            Err(error) => {
+                // A broken file keeps the defaults rather than taking the controls away.
+                log::warn!("Horizon: touch layout {}: {error}", path.display());
+                None
+            }
+        },
+        Err(error) => {
+            if error.kind() == std::io::ErrorKind::NotFound {
+                let text = touch_hud::default_file(width, height);
+                match std::fs::write(&path, &text) {
+                    Ok(()) => log::info!("Horizon: touch layout written to {}", path.display()),
+                    Err(error) => log::warn!("Horizon: touch layout {}: {error}", path.display()),
+                }
+                serde_json::from_str(&text).ok()
+            } else {
+                log::warn!("Horizon: touch layout {}: {error}", path.display());
+                None
+            }
+        }
+    };
+    held.stamp = std::fs::metadata(&path).and_then(|meta| meta.modified()).ok();
+    held.custom = custom.clone();
+    custom
+}
+
+/// The layout file as last read: its stamp, what it said, and when it was last looked at.
+#[derive(Default)]
+struct Cached {
+    stamp: Option<std::time::SystemTime>,
+    custom: Option<touch_hud::Custom>,
+    checked: Option<std::time::Instant>,
+}
+
+fn touch() -> &'static Mutex<Touch> {
+    static TOUCH: OnceLock<Mutex<Touch>> = OnceLock::new();
+    TOUCH.get_or_init(|| Mutex::new(Touch::default()))
+}
+
+#[cfg_attr(not(target_os = "ios"), allow(dead_code))]
+impl Game<'_> {
+    /// The framebuffer the renderer draws into.
+    fn framebuffer(&self) -> (u32, u32) {
+        self.renderer
+            .as_ref()
+            .map_or((0, 0), |renderer| (renderer.config.width, renderer.config.height))
+    }
+    /// A touch, in physical pixels, as the controls see it.
+    pub(super) fn ios_touch(&mut self, id: u64, phase: TouchPhase, x: f64, y: f64) {
+        // A finger that lifts is always let go of, whatever the screen says
+        // now: a press whose release is dropped leaves a key held down, and a
+        // held jump key jumps again every time the view turns.
+        if matches!(phase, TouchPhase::Ended | TouchPhase::Cancelled) {
+            self.ios_release(id);
+            return;
+        }
+        if self.screen != Screen::Playing {
+            // A container screen has no Escape key on a phone: a tap beside its panel closes
+            // it, as the mouse does on the desktop, unless a stack is carried — that tap
+            // drops the stack, and the screen stays open for the rest of it.
+            if matches!(phase, TouchPhase::Started) {
+                let _ = self.ios_container_tap(x, y);
+            }
+            return;
+        }
+        if self.pad_radial_captures() {
+            return;
+        }
+        let (width, height) = self.framebuffer();
+        if width == 0 || height == 0 {
+            return;
+        }
+        let scale = horizon_client::hud::HudBatch::new([width, height]).scale;
+        let (gui_x, gui_y) = (x as f32 / scale, y as f32 / scale);
+        let layout = touch_hud::layout_with(
+            (width as f32 / scale).ceil(),
+            (height as f32 / scale).ceil(),
+            custom_layout(
+                (width as f32 / scale).ceil(),
+                (height as f32 / scale).ceil(),
+            )
+            .as_ref(),
+        );
+        // Only a touch that starts or ends is logged: a drag reports `Moved` at
+        // the display's rate, and a line per move is a file write per move.
+        if !matches!(phase, TouchPhase::Moved) {
+            let share_x = gui_x / layout.width;
+            let share_y = gui_y / layout.height;
+            log::info!(
+                "Horizon: touch {id} {phase:?} gui {gui_x:.0},{gui_y:.0} of {width}x{height} (share {share_x:.3},{share_y:.3}) scale {scale}"
+            );
+        }
+        let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+        state.mark = Some((gui_x, gui_y));
+        state.layout = Some(layout.clone());
+        match phase {
+            TouchPhase::Started => {
+                if let Some(button) = layout.button_at(gui_x, gui_y) {
+                    log::info!("Horizon: touch {id} on button {button:?}");
+                    state.held.push((id, button));
+                    if matches!(button, Button::Attack | Button::Place) {
+                        state.slide = Some((id, touch_hud::Handle::Button(button), (x as f32, y as f32)));
+                    }
+                    drop(state);
+                    self.ios_button(button, true);
+                } else if let Some(slot) = layout.hotbar_slot(gui_x, gui_y) {
+                    drop(state);
+                    self.ios_hotbar(slot);
+                } else if layout.on_stick(gui_x, gui_y) {
+                    log::info!("Horizon: touch {id} on the stick");
+                    state.stick = Some(id);
+                    state.origin = (gui_x, gui_y);
+                    state.knob = (gui_x, gui_y);
+                } else {
+                    log::info!("Horizon: touch {id} turns the view");
+                    state.look = Some(id);
+                    // The pointer the game turns with moves in physical pixels
+                    // (`WindowEvent::CursorMoved`), so the view is turned by the
+                    // motion in those, not by the coarser GUI units the layout is
+                    // measured in.
+                    state.last = (x as f32, y as f32);
+                }
+            }
+            TouchPhase::Moved => {
+                if let Some((finger, handle, at)) = state.slide {
+                    if finger == id {
+                        let (dx, dy) = (x as f32 - at.0, y as f32 - at.1);
+                        state.slide = Some((id, handle, (x as f32, y as f32)));
+                        state.mark = Some((gui_x, gui_y));
+                        drop(state);
+                        self.ios_look(f64::from(dx), f64::from(dy));
+                        return;
+                    }
+                }
+                if state.stick == Some(id) {
+                    let (dx, dy) = (gui_x - state.origin.0, gui_y - state.origin.1);
+                    let length = (dx * dx + dy * dy).sqrt();
+                    let reach = layout.stick_radius;
+                    let (kx, ky) = if length > reach {
+                        (dx * reach / length, dy * reach / length)
+                    } else {
+                        (dx, dy)
+                    };
+                    state.knob = (state.origin.0 + kx, state.origin.1 + ky);
+                    drop(state);
+                    self.ios_stick(kx / reach, -ky / reach);
+                } else if state.look == Some(id) {
+                    let (px, py) = (x as f32, y as f32);
+                    let (dx, dy) = (px - state.last.0, py - state.last.1);
+                    state.last = (px, py);
+                    drop(state);
+                    self.ios_look(f64::from(dx), f64::from(dy));
+                }
+            }
+            // A lifting finger is handled by `ios_release`, before the gates.
+            TouchPhase::Ended | TouchPhase::Cancelled => drop(state),
+        }
+    }
+    /// The stick, as a direction with each axis in `-1..=1`.
+    fn ios_stick(&mut self, right: f32, forward: f32) {
+        const DEAD: f32 = 0.25;
+        self.ios_key(KeyCode::KeyW, forward > DEAD);
+        self.ios_key(KeyCode::KeyS, forward < -DEAD);
+        self.ios_key(KeyCode::KeyD, right > DEAD);
+        self.ios_key(KeyCode::KeyA, right < -DEAD);
+        self.ios_key(
+            KeyCode::ControlLeft,
+            right.abs() > 0.92 || forward.abs() > 0.92,
+        );
+    }
+    /// A tap on the hotbar row picks that slot.
+    fn ios_hotbar(&mut self, slot: usize) {
+        const SLOTS: [KeyCode; 9] = [
+            KeyCode::Digit1,
+            KeyCode::Digit2,
+            KeyCode::Digit3,
+            KeyCode::Digit4,
+            KeyCode::Digit5,
+            KeyCode::Digit6,
+            KeyCode::Digit7,
+            KeyCode::Digit8,
+            KeyCode::Digit9,
+        ];
+        if let Some(code) = SLOTS.get(slot).copied() {
+            self.ios_key(code, true);
+            self.ios_key(code, false);
+        }
+    }
+    /// A button, pressed or let go.
+    fn ios_button(&mut self, button: Button, pressed: bool) {
+        match button {
+            Button::Jump => self.ios_key(KeyCode::Space, pressed),
+            Button::Sneak => self.ios_sneak(pressed),
+            Button::Attack => self.ios_mouse(MouseButton::Left, pressed),
+            Button::Place => self.ios_mouse(MouseButton::Right, pressed),
+            Button::Inventory => self.ios_key(KeyCode::KeyE, pressed),
+            Button::Chat => self.ios_key(KeyCode::KeyT, pressed),
+            Button::Pause => self.ios_key(KeyCode::Escape, pressed),
+        }
+    }
+    /// Sneak, as a tap: a finger cannot hold a key down for a walk, so the button flips the
+    /// toggle the mapping keeps instead of holding it. A press flips it, a release does
+    /// nothing: with the vanilla `toggle_crouch`, a hold would sneak for the length of the tap
+    /// only, which is under a frame at the rate a finger lifts.
+    fn ios_sneak(&mut self, pressed: bool) {
+        if !pressed {
+            return;
+        }
+        let slot = horizon_client_input::keymapping::SNEAK;
+        let screen_open = !super::key_codes::gameplay_has_keyboard(
+            self.screen,
+            self.title.is_some(),
+            self.screen_over_playing(),
+        );
+        self.toggles.pad_toggle(slot, screen_open);
+        self.sync_toggle(slot);
+        log::info!("Horizon: touch sneak toggled to {}", self.toggles.is_down(slot));
+    }
+    /// A tap on a screen with a container: beside the panel it closes the screen, when nothing
+    /// is on the cursor. A tap with a stack carried is a drop, and the screen stays. `true`
+    /// when the tap closed the screen: the caller then drops it, so it is not also a click on
+    /// whatever the finger covered.
+    pub(super) fn ios_container_tap(&mut self, x: f64, y: f64) -> bool {
+        let (width, height) = self.framebuffer();
+        if width == 0 || height == 0 {
+            return false;
+        }
+        let scale = horizon_client::hud::HudBatch::new([width, height]).scale;
+        let (gui_x, gui_y) = (x as f32 / scale, y as f32 / scale);
+        let (gui_w, gui_h) = (
+            (width as f32 / scale).ceil(),
+            (height as f32 / scale).ceil(),
+        );
+        // The panel's own numbers, not a guess: `inventory_origin` (inventory_slots.rs)
+        // centres the menu's width and height and then slides it by the recipe book
+        // (recipe_book.rs:156, 77 units when it is open), and `screen_height` gives each
+        // station, chest, shulker and machine its real height. Creative is its own panel.
+        let (panel_w, panel_h, x0, y0) = if self.screen == Screen::Creative {
+            let (w, h) = (
+                horizon_client::creative::Creative::WIDTH,
+                horizon_client::creative::Creative::HEIGHT,
+            );
+            (w, h, (gui_w - w) * 0.5, (gui_h - h) * 0.5)
+        } else if self.screen == Screen::Inventory {
+            let w = self.native_screen_width().unwrap_or(176.0);
+            let h = self.screen_height();
+            (
+                w,
+                h,
+                (gui_w - w) * 0.5 + self.recipe_book_shift(gui_w),
+                (gui_h - h) * 0.5,
+            )
+        } else {
+            return false;
+        };
+        let outside =
+            gui_x < x0 || gui_x > x0 + panel_w || gui_y < y0 || gui_y > y0 + panel_h;
+        if !outside {
+            log::info!(
+                "Horizon: touch {gui_x:.0},{gui_y:.0} inside the panel {x0:.0},{y0:.0} {panel_w}x{panel_h}"
+            );
+            return false;
+        }
+        if self.carried.is_some() {
+            log::info!("Horizon: touch outside the inventory with a stack carried: not closing");
+            return false;
+        }
+        log::info!("Horizon: touch outside the inventory: closing");
+        self.ios_key(KeyCode::Escape, true);
+        self.ios_key(KeyCode::Escape, false);
+        true
+    }
+    /// A key, as the window's own key event delivers it: through the mapping, so sneak and
+    /// sprint reach their toggles. `keys.press` alone is undone on the next modifier sync
+    /// (`sync_toggle` writes the toggle's state over the key), which is why a sneak pressed
+    /// as a bare key never lasted a frame.
+    fn ios_key(&mut self, code: KeyCode, pressed: bool) {
+        if let Err(error) = self.mapped_key(code, pressed, false, code, Source::Agent) {
+            log::warn!("Horizon: touch key {code:?} pressed={pressed}: {error}");
+        }
+    }
+    /// A mouse button in the world.
+    fn ios_mouse(&mut self, button: MouseButton, pressed: bool) {
+        if self.screen != Screen::Playing {
+            return;
+        }
+        self.extras_mouse(button, pressed);
+        if let Err(error) = self.mouse_mapping(button, pressed, Source::Agent) {
+            log::warn!("Horizon: touch mouse {button:?}: {error}");
+        }
+    }
+    /// The look: the same accumulated motion a grabbed mouse makes.
+    fn ios_look(&mut self, dx: f64, dy: f64) {
+        if dx == 0.0 && dy == 0.0 {
+            return;
+        }
+        // A finger is a pointer the system never lets the game grab, which is
+        // the case `agent_pointer` already covers (`horizon-ctl mouse-move`):
+        // `apply_mouse_look` wants an active window, and iOS sends no focus
+        // event, so without this the motion would accumulate and be dropped.
+        {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            state.pending = (
+                state.pending.0 + dx * LOOK_GAIN,
+                state.pending.1 + dy * LOOK_GAIN,
+            );
+        }
+        self.flush_look(0.5);
+        self.last_input = Instant::now();
+    }
+    /// Hand `part` of the drag the fingers have reported to the mouse. A
+    /// digitiser reports motion in bursts, and turning the view by a burst in
+    /// one frame is what the eye sees as the view jumping; half per frame
+    /// spreads a burst over two and the drag reads as one movement.
+    /// `add_motion`, not `on_move`: a finger has no position of its own as far
+    /// as the pointer is concerned, and reporting one would leave the mouse
+    /// where the finger last was, so the next click's `CursorMoved` would
+    /// arrive as a jump across the screen.
+    fn flush_look(&mut self, part: f64) {
+        let step = {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            let step = (state.pending.0 * part, state.pending.1 * part);
+            state.pending = (state.pending.0 - step.0, state.pending.1 - step.1);
+            if state.pending.0.abs() < 0.01 && state.pending.1.abs() < 0.01 {
+                state.pending = (0.0, 0.0);
+            }
+            step
+        };
+        if step.0 == 0.0 && step.1 == 0.0 {
+            return;
+        }
+        // `agent_pointer`, not `captured`: the grab is the window's, and claiming it
+        // here would have `capture(false)` take the keys of a player who is walking.
+        self.agent_pointer = true;
+        self.mouse.add_motion(step.0, step.1);
+    }
+    /// Every key and button the controls are holding, let go of: a screen that takes the
+    /// keyboard away (the pause menu, the inventory) must not leave a jump held, or the
+    /// player hops for as long as the menu stays open and after it closes.
+    pub(super) fn ios_release_all(&mut self) {
+        let (held, stick) = {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            if state.held.is_empty() && state.stick.is_none() && state.look.is_none() {
+                return;
+            }
+            let held = std::mem::take(&mut state.held);
+            let stick = state.stick.is_some() || state.knob != state.origin;
+            state.stick = None;
+            state.look = None;
+            state.slide = None;
+            state.drag = None;
+            state.pending = (0.0, 0.0);
+            state.knob = state.layout.as_ref().map_or((0.0, 0.0), |l| l.stick);
+            (held, stick)
+        };
+        if stick {
+            self.ios_stick(0.0, 0.0);
+        }
+        for (_, button) in held {
+            self.ios_button(button, false);
+        }
+        self.agent_pointer = false;
+    }
+    /// Everything one finger was holding or turning, let go of.
+    pub(super) fn ios_release(&mut self, id: u64) {
+        let (stick, button, look) = {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            let stick = state.stick == Some(id);
+            if stick {
+                state.stick = None;
+                state.knob = state.layout.as_ref().map_or((0.0, 0.0), |l| l.stick);
+            }
+            let look = state.look == Some(id);
+            if look {
+                state.look = None;
+            }
+            if state.slide.is_some_and(|(finger, _, _)| finger == id) {
+                state.slide = None;
+            }
+            let button = state
+                .held
+                .iter()
+                .position(|(finger, _)| *finger == id)
+                .map(|index| state.held.remove(index).1);
+            (stick, button, look)
+        };
+        if stick {
+            self.ios_stick(0.0, 0.0);
+        }
+        if let Some(button) = button {
+            self.ios_button(button, false);
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            state
+                .latched
+                .push((button, std::time::Instant::now() + LATCH));
+        }
+        if look {
+            // The rest of the drag still turns the view, over the next frames.
+            let _ = self.flush_look(0.5);
+            self.agent_pointer = false;
+        }
+    }
+    /// The controls, over the HUD.
+    pub(super) fn draw_touch_controls(&mut self, batch: &mut horizon_client::hud::HudBatch) {
+        let atlas = &self.gui.atlas;
+        let (layout, knob, held) = {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            let Some(layout) = state.layout.clone() else {
+                return;
+            };
+            let now = std::time::Instant::now();
+            state.latched.retain(|(_, until)| *until > now);
+            let mut held: Vec<Button> = state.held.iter().map(|(_, button)| *button).collect();
+            held.extend(state.latched.iter().map(|(button, _)| *button));
+            let mut layout = layout;
+            layout.touch = state.mark;
+            layout.edit = state.edit;
+            layout.debug = state.debug || state.edit;
+            let knob = if layout.edit { layout.stick } else { state.knob };
+            (layout, knob, held)
+        };
+        touch_hud::paint(batch, atlas, &layout, knob, |button| held.contains(&button));
+        // Whatever the fingers reported since the last frame turns the view
+        // now, a share at a time, on the frame that reads it.
+        self.flush_look(0.5);
+    }
+}
