+//! The on-screen touch controls of the iOS client: where the stick, the look
+//! area and the buttons sit, the draws for them and the hit test the touch
+//! handler uses.
+//!
+//! Laid out like Bedrock's default touch controls: the stick bottom left, jump,
+//! sneak, attack and place bottom right, the menu buttons on the right above
+//! them, and the hotbar row along the bottom centre. Everything is in GUI units
+//! (`wi` by `hi`, the size the HUD draws in), so a touch in pixels divides by
+//! the same GUI scale the HUD uses.
+use crate::hud::{HudAtlas, HudBatch};
+use crate::hud_layout;
+
+/// A button the touch handler can press.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Button {
+    Jump,
+    Sneak,
+    Attack,
+    Place,
+    Inventory,
+    Chat,
+    Pause,
+}
+
+impl Button {
+    /// The label drawn on the button.
+    pub fn label(self) -> &'static str {
+        match self {
+            Button::Jump => "JMP",
+            Button::Sneak => "SNK",
+            Button::Attack => "HIT",
+            Button::Place => "PUT",
+            Button::Inventory => "INV",
+            Button::Chat => "CHT",
+            Button::Pause => "ESC",
+        }
+    }
+}
+
+/// A rectangle in GUI units.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Rect {
+    pub x0: f32,
+    pub y0: f32,
+    pub x1: f32,
+    pub y1: f32,
+}
+
+impl Rect {
+    pub fn contains(&self, x: f32, y: f32) -> bool {
+        x >= self.x0 && x <= self.x1 && y >= self.y0 && y <= self.y1
+    }
+    pub fn centre(&self) -> (f32, f32) {
+        ((self.x0 + self.x1) * 0.5, (self.y0 + self.y1) * 0.5)
+    }
+}
+
+/// The stick's radius in GUI units: the knob travels this far from where the
+/// thumb landed before the move counts as full speed.
+pub const STICK_RADIUS: f32 = 24.0;
+/// The stick's resting place, from the bottom left corner.
+pub const STICK_CENTRE: (f32, f32) = (52.0, 52.0);
+/// How tall the hotbar row's hit strip is, above the bottom edge.
+pub const HOTBAR_HEIGHT: f32 = 22.0;
+/// The hotbar's width: nine 20-unit slots and their padding.
+pub const HOTBAR_WIDTH: f32 = 182.0;
+const BUTTON: f32 = 44.0;
+/// The stick's drawn diameter in GUI units (the pad sprite is 64 px).
+const STICK_PAD: f32 = 120.0;
+/// The knob's drawn diameter.
+const STICK_KNOB: f32 = 56.0;
+
+/// Where everything sits on a `width` by `height` GUI screen.
+#[derive(Clone)]
+pub struct Layout {
+    pub width: f32,
+    pub height: f32,
+    pub stick: (f32, f32),
+    /// The drawn diameter of the stick's pad and knob, in GUI units.
+    pub pad: f32,
+    pub knob: f32,
+    /// How far the knob travels before a move counts as full speed.
+    pub stick_radius: f32,
+    pub buttons: [(Button, Rect); 7],
+    /// The area that turns the view: everything not taken by the stick, the
+    /// buttons or the hotbar.
+    pub look: Rect,
+    pub hotbar: Rect,
+    /// Draw the ruler: the grid of tenths and the last touch point.
+    pub debug: bool,
+    /// Where the last finger went down, in GUI units, for the mark in the ruler.
+    pub touch: Option<(f32, f32)>,
+    /// The controls can be dragged and the file is written back when they are let go.
+    pub edit: bool,
+}
+
+/// The layout for a screen `width` by `height` GUI units across.
+pub fn layout(width: f32, height: f32) -> Layout {
+    layout_with(width, height, None)
+}
+
+/// The layout of a `width` by `height` GUI screen, with the parts a person set in
+/// `Documents/touch_layout.json` left where they put them and the rest at their defaults.
+pub fn layout_with(width: f32, height: f32, custom: Option<&Custom>) -> Layout {
+    let button = custom.and_then(|c| c.button_size).unwrap_or(BUTTON).max(16.0);
+    let pad = custom.and_then(|c| c.stick_size).unwrap_or(STICK_PAD).max(40.0);
+    let knob = custom.and_then(|c| c.knob_size).unwrap_or(STICK_KNOB).max(16.0);
+    let right = width - 10.0;
+    let bottom = height - 12.0;
+    let at = |x1: f32, y1: f32| Rect {
+        x0: x1 - button,
+        y0: y1 - button,
+        x1,
+        y1,
+    };
+    // Bottom right cluster: jump and sneak in the corner column, attack and
+    // place one column left, the menus above them.
+    let buttons = [
+        (Button::Jump, at(right, bottom)),
+        (Button::Sneak, at(right, bottom - button - 6.0)),
+        (
+            Button::Attack,
+            at(right - button - 6.0, bottom),
+        ),
+        (
+            Button::Place,
+            at(right - BUTTON - 6.0, bottom - button - 6.0),
+        ),
+        (
+            Button::Inventory,
+            at(right, bottom - 2.0 * (button + 6.0)),
+        ),
+        (
+            Button::Chat,
+            at(right - BUTTON - 6.0, bottom - 2.0 * (button + 6.0)),
+        ),
+        (
+            Button::Pause,
+            at(right, bottom - 3.0 * (button + 6.0)),
+        ),
+    ];
+    let hotbar = Rect {
+        x0: (width - HOTBAR_WIDTH) * 0.5,
+        y0: height - HOTBAR_HEIGHT,
+        x1: (width + HOTBAR_WIDTH) * 0.5,
+        y1: height,
+    };
+    let put = |place: [f32; 2]| (width * place[0], height * place[1]);
+    let mut layout = Layout {
+        width,
+        height,
+        stick: (STICK_CENTRE.0, height - STICK_CENTRE.1),
+        pad,
+        knob,
+        stick_radius: pad * 0.2,
+        buttons,
+        look: Rect {
+            x0: width * 0.34,
+            y0: 0.0,
+            x1: width,
+            y1: height,
+        },
+        hotbar,
+        debug: false,
+        touch: None,
+        edit: false,
+    };
+    let Some(custom) = custom else {
+        return layout;
+    };
+    layout.debug = custom.debug.unwrap_or(false) || custom.edit.unwrap_or(false);
+    layout.edit = custom.edit.unwrap_or(false);
+    if let Some(place) = custom.stick {
+        layout.stick = put(place);
+    }
+    if let Some([x, y]) = custom.hotbar {
+        let half = HOTBAR_WIDTH * 0.5;
+        layout.hotbar = Rect {
+            x0: width * x - half,
+            y0: height * y - HOTBAR_HEIGHT,
+            x1: width * x + half,
+            y1: height * y,
+        };
+    }
+    if let Some(places) = &custom.buttons {
+        for (slot, rect) in layout.buttons.iter_mut() {
+            let Some(at) = places.get(key(*slot)) else {
+                continue;
+            };
+            // A place is the button's centre.
+            let (cx, cy) = put(*at);
+            *rect = Rect {
+                x0: cx - button * 0.5,
+                y0: cy - button * 0.5,
+                x1: cx + button * 0.5,
+                y1: cy + button * 0.5,
+            };
+        }
+    }
+    if let Some(sizes) = &custom.buttons_size {
+        for (slot, rect) in layout.buttons.iter_mut() {
+            let Some(side) = sizes.get(key(*slot)) else {
+                continue;
+            };
+            // A side is the button's own edge length, grown or shrunk around its centre.
+            let side = side.max(16.0);
+            let (cx, cy) = rect.centre();
+            *rect = Rect {
+                x0: cx - side * 0.5,
+                y0: cy - side * 0.5,
+                x1: cx + side * 0.5,
+                y1: cy + side * 0.5,
+            };
+        }
+    }
+    if let Some(share) = custom.look_from {
+        layout.look.x0 = width * share;
+    }
+    layout
+}
+
+/// The key a button is named by in `touch_layout.json`.
+fn key(button: Button) -> &'static str {
+    match button {
+        Button::Jump => "jump",
+        Button::Sneak => "sneak",
+        Button::Attack => "attack",
+        Button::Place => "place",
+        Button::Inventory => "inventory",
+        Button::Chat => "chat",
+        Button::Pause => "pause",
+    }
+}
+
+/// The parts a person set in `Documents/touch_layout.json`. Every field is optional: what is
+/// left out stays at its default, so a file with one button moved is easy to write.
+#[derive(Clone, Debug, Default, serde::Deserialize)]
+pub struct Custom {
+    /// Button side, GUI units.
+    #[serde(default)]
+    pub button_size: Option<f32>,
+    /// Stick pad and knob diameters, GUI units.
+    #[serde(default)]
+    pub stick_size: Option<f32>,
+    #[serde(default)]
+    pub knob_size: Option<f32>,
+    /// Where the stick's centre sits: `[x, y]` as shares of the screen.
+    #[serde(default)]
+    pub stick: Option<[f32; 2]>,
+    /// Where the hotbar row's bottom edge sits: `[x, y]` as shares of the screen.
+    #[serde(default)]
+    pub hotbar: Option<[f32; 2]>,
+    /// Button centres, by name: `{ "jump": [0.93, 0.93] }`.
+    #[serde(default)]
+    pub buttons: Option<std::collections::BTreeMap<String, [f32; 2]>>,
+    /// Button sides that differ from `button_size`, by name: `{ "jump": 60 }`.
+    #[serde(default)]
+    pub buttons_size: Option<std::collections::BTreeMap<String, f32>>,
+    /// The share of the width where the look area starts, leaving the left to the stick.
+    #[serde(default)]
+    pub look_from: Option<f32>,
+    /// Draw a grid of tenths and a mark where the last finger landed, so a person can read
+    /// the shares to write in this file.
+    #[serde(default)]
+    pub debug: Option<bool>,
+    /// Start with the controls picked up and movable by hand.
+    #[serde(default)]
+    pub edit: Option<bool>,
+}
+
+/// The file a person edits, written the first time the client runs so its format is there to
+/// copy rather than to guess.
+pub const FILE: &str = "touch_layout.json";
+
+/// A layout baked into the build, so a fresh install starts where the person put the
+/// controls instead of where the defaults are. Empty means the defaults are written.
+pub const BAKED: &str = concat!(
+    "{",
+    "  \"button_size\": 18,",
+    "  \"buttons\": {",
+    "    \"attack\": [",
+    "      0.827,",
+    "      0.699",
+    "    ],",
+    "    \"chat\": [",
+    "      0.479,",
+    "      0.041",
+    "    ],",
+    "    \"inventory\": [",
+    "      0.672,",
+    "      0.959",
+    "    ],",
+    "    \"jump\": [",
+    "      0.927,",
+    "      0.398",
+    "    ],",
+    "    \"pause\": [",
+    "      0.521,",
+    "      0.041",
+    "    ],",
+    "    \"place\": [",
+    "      0.927,",
+    "      0.797",
+    "    ],",
+    "    \"sneak\": [",
+    "      0.926,",
+    "      0.6",
+    "    ]",
+    "  },",
+    "  \"buttons_size\": {",
+    "    \"attack\": 30,",
+    "    \"chat\": 18,",
+    "    \"inventory\": 18,",
+    "    \"jump\": 30,",
+    "    \"pause\": 18,",
+    "    \"place\": 30,",
+    "    \"sneak\": 30",
+    "  },",
+    "  \"debug\": false,",
+    "  \"edit\": false,",
+    "  \"hotbar\": [",
+    "    0.5,",
+    "    1.0",
+    "  ],",
+    "  \"knob_size\": 31,",
+    "  \"look_from\": 0.34,",
+    "  \"stick\": [",
+    "    0.148,",
+    "    0.749",
+    "  ],",
+    "  \"stick_size\": 66",
+    "}",
+);
+
+/// The layout a person would find in the file if it were written now: the defaults.
+#[must_use]
+pub fn default_file(width: f32, height: f32) -> String {
+    if !BAKED.is_empty() {
+        return BAKED.to_owned();
+    }
+    let mut places = std::collections::BTreeMap::new();
+    let layout = layout(width, height);
+    let share = |x: f32, y: f32| [x / layout.width, y / layout.height];
+    for (button, rect) in layout.buttons {
+        let (x, y) = rect.centre();
+        let [x, y] = share(x, y);
+        places.insert(
+            key(button).to_owned(),
+            [x.clamp(0.0, 1.0), y.clamp(0.0, 1.0)],
+        );
+    }
+    let [sx, sy] = share(layout.stick.0, layout.stick.1);
+    let doc = serde_json::json!({
+        "button_size": BUTTON,
+        "stick_size": STICK_PAD,
+        "knob_size": STICK_KNOB,
+        "stick": [sx, sy],
+        "hotbar": [0.5, 1.0],
+        "look_from": 0.34,
+        "buttons": places,
+    });
+    serde_json::to_string_pretty(&doc).unwrap_or_default()
+}
+
+impl Layout {
+    /// The button under a point in GUI units, or `None` in the look or stick
+    /// area.
+    pub fn button_at(&self, x: f32, y: f32) -> Option<Button> {
+        self.buttons
+            .iter()
+            .find(|(_, rect)| rect.contains(x, y))
+            .map(|(button, _)| *button)
+    }
+    /// The handle the layout button occupies: top-left corner, small enough to miss while
+    /// playing and big enough to hit with a thumb.
+    #[must_use]
+    /// Where the layout's own toggle sat. Nothing draws it now — the layout is the file
+    /// and nothing else — but the hit test that used to be there stays out of the corner:
+    /// a thumb resting in it is a drag, not a button.
+    pub fn toggle(&self) -> Rect {
+        Rect {
+            x0: 0.0,
+            y0: 0.0,
+            x1: 0.0,
+            y1: 0.0,
+        }
+    }
+    /// The control a point in GUI units picks up, looking at the buttons first and the stick's
+    /// whole pad after them.
+    #[must_use]
+    pub fn handle_at(&self, x: f32, y: f32) -> Option<Handle> {
+        if let Some(button) = self.button_at(x, y) {
+            return Some(Handle::Button(button));
+        }
+        let (sx, sy) = self.stick;
+        let half = self.pad * 0.5;
+        if (x - sx).abs() <= half && (y - sy).abs() <= half {
+            return Some(Handle::Stick);
+        }
+        self.hotbar.contains(x, y).then_some(Handle::Hotbar)
+    }
+    /// Puts a control's centre at a point in GUI units.
+    pub fn move_handle(&mut self, handle: Handle, x: f32, y: f32) {
+        let (x, y) = (x.clamp(0.0, self.width), y.clamp(0.0, self.height));
+        match handle {
+            Handle::Stick => {
+                self.stick = (x, y);
+            }
+            Handle::Button(button) => {
+                let side = self
+                    .buttons
+                    .iter()
+                    .find(|(slot, _)| *slot == button)
+                    .map_or(44.0, |(_, rect)| rect.x1 - rect.x0);
+                if let Some((_, rect)) = self.buttons.iter_mut().find(|(slot, _)| *slot == button) {
+                    *rect = Rect {
+                        x0: x - side * 0.5,
+                        y0: y - side * 0.5,
+                        x1: x + side * 0.5,
+                        y1: y + side * 0.5,
+                    };
+                }
+            }
+            Handle::Hotbar => {
+                // The hotbar keeps its width; only its middle moves.
+                let half = (self.hotbar.x1 - self.hotbar.x0) * 0.5;
+                let height = self.hotbar.y1 - self.hotbar.y0;
+                self.hotbar = Rect {
+                    x0: x - half,
+                    y0: y - height,
+                    x1: x + half,
+                    y1: y,
+                };
+            }
+        }
+    }
+    /// The file that would put every control back where it is now.
+    #[must_use]
+    pub fn file(&self) -> String {
+        let share = |x: f32, y: f32| [x / self.width, y / self.height];
+        let mut places = std::collections::BTreeMap::new();
+        for (button, rect) in self.buttons {
+            let (x, y) = rect.centre();
+            let [x, y] = share(x, y);
+            places.insert(key(button).to_owned(), [x, y]);
+        }
+        let [sx, sy] = share(self.stick.0, self.stick.1);
+        let [hx, hy] = share(
+            (self.hotbar.x0 + self.hotbar.x1) * 0.5,
+            self.hotbar.y1,
+        );
+        let mut sides = std::collections::BTreeMap::new();
+        for (button, rect) in self.buttons {
+            sides.insert(key(button).to_owned(), (rect.x1 - rect.x0).round());
+        }
+        let doc = serde_json::json!({
+            "button_size": (self.buttons[0].1.x1 - self.buttons[0].1.x0).round(),
+            "buttons_size": sides,
+            "stick_size": self.pad.round(),
+            "knob_size": self.knob.round(),
+            "stick": [sx, sy],
+            "hotbar": [hx, hy],
+            "look_from": self.look.x0 / self.width,
+            "buttons": places,
+            "debug": self.debug,
+            "edit": self.edit,
+        });
+        serde_json::to_string_pretty(&doc).unwrap_or_default()
+    }
+    /// Whether a point in GUI units is in the stick's half of the screen.
+    pub fn on_stick(&self, x: f32, y: f32) -> bool {
+        x < self.look.x0 && y > self.height * 0.35
+    }
+    /// The hotbar slot (0-8) under a point in GUI units.
+    pub fn hotbar_slot(&self, x: f32, y: f32) -> Option<usize> {
+        if !self.hotbar.contains(x, y) {
+            return None;
+        }
+        let slot = ((x - self.hotbar.x0) / (HOTBAR_WIDTH / 9.0)) as i32;
+        Some(slot.clamp(0, 8) as usize)
+    }
+}
+
+/// Something the hand can pick up in edit mode.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Handle {
+    Stick,
+    Button(Button),
+    Hotbar,
+}
+
+/// The sprite of a button in `gui/sprites/horizon/touch/`.
+fn sprite(button: Button, down: bool) -> &'static str {
+    match (button, down) {
+        (Button::Jump, false) => "horizon/touch/jump",
+        (Button::Jump, true) => "horizon/touch/jump_active",
+        (Button::Sneak, false) => "horizon/touch/sneak",
+        (Button::Sneak, true) => "horizon/touch/sneak_active",
+        (Button::Attack, false) => "horizon/touch/attack",
+        (Button::Attack, true) => "horizon/touch/attack_active",
+        (Button::Place, false) => "horizon/touch/use",
+        (Button::Place, true) => "horizon/touch/use_active",
+        (Button::Inventory, false) => "horizon/touch/inventory",
+        (Button::Inventory, true) => "horizon/touch/inventory_active",
+        (Button::Chat, false) => "horizon/touch/chat",
+        (Button::Chat, true) => "horizon/touch/chat_active",
+        (Button::Pause, false) => "horizon/touch/pause",
+        (Button::Pause, true) => "horizon/touch/pause_active",
+    }
+}
+
+/// A sprite blit in GUI units, at its own size.
+fn blit(draws: &mut Vec<hud_layout::GuiDraw>, sprite: &'static str, x: f32, y: f32, w: f32, h: f32) {
+    draws.push(hud_layout::GuiDraw::Sprite {
+        sprite: std::borrow::Cow::Borrowed(sprite),
+        x: x.round() as i32,
+        y: y.round() as i32,
+        w: w.round() as i32,
+        h: h.round() as i32,
+        region: None,
+        color: 0xFFFF_FFFF,
+        blend: hud_layout::Blend::Textured,
+    });
+}
+
+/// Draws the controls: the stick with its knob at `knob`, and every button,
+/// its pressed sprite while `held` says its finger is down. A control whose
+/// sprite the atlas lacks still gets a plate, so the controls are usable with
+/// a resource pack that predates them.
+/// A frame one unit thick around a control, so an edit-mode control is easy to see.
+fn outline(draws: &mut Vec<hud_layout::GuiDraw>, rect: Rect, color: u32) {
+    let (x0, y0) = (rect.x0.round() as i32, rect.y0.round() as i32);
+    let (x1, y1) = (rect.x1.round() as i32, rect.y1.round() as i32);
+    let mut part = |a: [i32; 4]| {
+        draws.push(hud_layout::fill(a[0], a[1], a[2], a[3], color));
+    };
+    part([x0, y0, x1, y0 + 1]);
+    part([x0, y1 - 1, x1, y1]);
+    part([x0, y0, x0 + 1, y1]);
+    part([x1 - 1, y0, x1, y1]);
+}
+
+/// Draws the ruler a person reads shares off: a line every tenth of the screen, brighter every
+/// half, and a mark where the last finger landed. `GuiDraw` has no text, so the lines carry the
+/// numbers and the exact values are in `horizon.log`.
+fn ruler(draws: &mut Vec<hud_layout::GuiDraw>, layout: &Layout) {
+    let (w, h) = (layout.width, layout.height);
+    let (wi, hi) = (w.round() as i32, h.round() as i32);
+    for step in 1..10 {
+        let share = step as f32 * 0.1;
+        // Every fifth line is the half-way mark a person can count from.
+        let faint = step % 5 == 0 || step == 1 || step == 9;
+        let color = if faint { 0x80_FF_FF_FF } else { 0x38_FF_FF_FF };
+        let x = (w * share).round() as i32;
+        draws.push(hud_layout::fill(x, 0, x + 1, hi, color));
+        let y = (h * share).round() as i32;
+        draws.push(hud_layout::fill(0, y, wi, y + 1, color));
+    }
+    if let Some((x, y)) = layout.touch {
+        // A cross the size of a button, so the mark is easy to find on a screenshot.
+        let arm = 11.0;
+        let (x, y) = (x.round() as i32, y.round() as i32);
+        let color = 0xC0_FF_50_50;
+        draws.push(hud_layout::fill(x - arm as i32, y, x + arm as i32, y + 1, color));
+        draws.push(hud_layout::fill(x, y - arm as i32, x + 1, y + arm as i32, color));
+    }
+}
+
+pub fn paint(
+    batch: &mut HudBatch,
+    atlas: &HudAtlas,
+    layout: &Layout,
+    knob: (f32, f32),
+    held: impl Fn(Button) -> bool,
+) {
+    let mut draws = Vec::new();
+    let mut absent = Vec::new();
+    let mut control = |draws: &mut Vec<hud_layout::GuiDraw>, sprite: &'static str, x: f32, y: f32, w: f32, h: f32| {
+        blit(draws, sprite, x, y, w, h);
+        if !atlas.sprites.contains_key(sprite) {
+            absent.push(sprite);
+            draws.push(hud_layout::fill(
+                x.round() as i32,
+                y.round() as i32,
+                (x + w).round() as i32,
+                (y + h).round() as i32,
+                0x90_1A_1A_20,
+            ));
+        }
+    };
+    if layout.debug {
+        ruler(&mut draws, layout);
+    }
+    if layout.edit {
+        // Picked-up controls wear a bright frame, so it is clear what can be dragged.
+        let edge = 0xC0_FF_D0_40;
+        for (_, rect) in &layout.buttons {
+            outline(&mut draws, *rect, edge);
+        }
+        let (sx, sy) = layout.stick;
+        let half = layout.pad * 0.5;
+        outline(
+            &mut draws,
+            Rect {
+                x0: sx - half,
+                y0: sy - half,
+                x1: sx + half,
+                y1: sy + half,
+            },
+            edge,
+        );
+        outline(&mut draws, layout.hotbar, edge);
+    }
+    let (sx, sy) = layout.stick;
+    control(
+        &mut draws,
+        "horizon/touch/pad",
+        sx - layout.pad * 0.5,
+        sy - layout.pad * 0.5,
+        layout.pad,
+        layout.pad,
+    );
+    control(
+        &mut draws,
+        "horizon/touch/stick",
+        knob.0 - layout.knob * 0.5,
+        knob.1 - layout.knob * 0.5,
+        layout.knob,
+        layout.knob,
+    );
+    for (button, rect) in &layout.buttons {
+        let down = held(*button);
+        let side = rect.x1 - rect.x0;
+        let sprite = sprite(*button, down);
+        control(&mut draws, sprite, rect.x0, rect.y0, side, side);
+    }
+    static REPORTED: std::sync::Once = std::sync::Once::new();
+    REPORTED.call_once(|| {
+        log::info!(
+            "Horizon: touch sprites missing from the atlas: {} ({})",
+            absent.len(),
+            absent.join(", ")
+        );
+    });
+    hud_layout::paint(batch, atlas, &draws);
+}
