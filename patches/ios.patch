+            KeyCode::Digit4,
+            KeyCode::Digit5,
+            KeyCode::Digit6,
+            KeyCode::Digit7,
+            KeyCode::Digit8,
+            KeyCode::Digit9,
+        ];
+        if let Some(code) = SLOTS.get(slot).copied() {
+            self.ios_key(code, true);
+            self.ios_key(code, false);
+        }
+    }
+    
+    fn ios_button(&mut self, button: Button, pressed: bool) {
+        match button {
+            Button::Jump => self.ios_key(KeyCode::Space, pressed),
+            Button::Sneak => self.ios_sneak(pressed),
+            Button::Attack => self.ios_mouse(MouseButton::Left, pressed),
+            Button::Place => self.ios_mouse(MouseButton::Right, pressed),
+            Button::Inventory => self.ios_key(KeyCode::KeyE, pressed),
+            Button::Chat => self.ios_key(KeyCode::KeyT, pressed),
+            Button::Pause => self.ios_key(KeyCode::Escape, pressed),
+        }
+    }
+    
+    
+    
+    
+    fn ios_sneak(&mut self, pressed: bool) {
+        if !pressed {
+            return;
+        }
+        let slot = horizon_client_input::keymapping::SNEAK;
+        let screen_open = !super::key_codes::gameplay_has_keyboard(
+            self.screen,
+            self.title.is_some(),
+            self.screen_over_playing(),
+        );
+        self.toggles.pad_toggle(slot, screen_open);
+        self.sync_toggle(slot);
+        log::info!("Horizon: touch sneak toggled to {}", self.toggles.is_down(slot));
+    }
+    
+    
+    
+    
+    pub(super) fn ios_container_tap(&mut self, x: f64, y: f64) -> bool {
+        let (width, height) = self.framebuffer();
+        if width == 0 || height == 0 {
+            return false;
+        }
+        let scale = horizon_client::hud::HudBatch::new([width, height]).scale;
+        let (gui_x, gui_y) = (x as f32 / scale, y as f32 / scale);
+        let (gui_w, gui_h) = (
+            (width as f32 / scale).ceil(),
+            (height as f32 / scale).ceil(),
+        );
+        
+        
+        
+        
+        let (panel_w, panel_h, x0, y0) = if self.screen == Screen::Creative {
+            let (w, h) = (
+                horizon_client::creative::Creative::WIDTH,
+                horizon_client::creative::Creative::HEIGHT,
+            );
+            (w, h, (gui_w - w) * 0.5, (gui_h - h) * 0.5)
+        } else if self.screen == Screen::Inventory {
+            let w = self.native_screen_width().unwrap_or(176.0);
+            let h = self.screen_height();
+            (
+                w,
+                h,
+                (gui_w - w) * 0.5 + self.recipe_book_shift(gui_w),
+                (gui_h - h) * 0.5,
+            )
+        } else {
+            return false;
+        };
+        let outside =
+            gui_x < x0 || gui_x > x0 + panel_w || gui_y < y0 || gui_y > y0 + panel_h;
+        if !outside {
+            log::info!(
+                "Horizon: touch {gui_x:.0},{gui_y:.0} inside the panel {x0:.0},{y0:.0} {panel_w}x{panel_h}"
+            );
+            return false;
+        }
+        if self.carried.is_some() {
+            log::info!("Horizon: touch outside the inventory with a stack carried: not closing");
+            return false;
+        }
+        log::info!("Horizon: touch outside the inventory: closing");
+        self.ios_key(KeyCode::Escape, true);
+        self.ios_key(KeyCode::Escape, false);
+        true
+    }
+    
+    
+    
+    
+    fn ios_key(&mut self, code: KeyCode, pressed: bool) {
+        if let Err(error) = self.mapped_key(code, pressed, false, code, Source::Agent) {
+            log::warn!("Horizon: touch key {code:?} pressed={pressed}: {error}");
+        }
+    }
+    
+    fn ios_mouse(&mut self, button: MouseButton, pressed: bool) {
+        if self.screen != Screen::Playing {
+            return;
+        }
+        self.extras_mouse(button, pressed);
+        if let Err(error) = self.mouse_mapping(button, pressed, Source::Agent) {
+            log::warn!("Horizon: touch mouse {button:?}: {error}");
+        }
+    }
+    
+    fn ios_look(&mut self, dx: f64, dy: f64) {
+        if dx == 0.0 && dy == 0.0 {
+            return;
+        }
+        
+        
+        
+        
+        {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            state.pending = (
+                state.pending.0 + dx * LOOK_GAIN,
+                state.pending.1 + dy * LOOK_GAIN,
+            );
+        }
+        self.flush_look(0.5);
+        self.last_input = Instant::now();
+    }
+    
+    
+    
+    
+    
+    
+    
+    
+    fn flush_look(&mut self, part: f64) {
+        let step = {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            let step = (state.pending.0 * part, state.pending.1 * part);
+            state.pending = (state.pending.0 - step.0, state.pending.1 - step.1);
+            if state.pending.0.abs() < 0.01 && state.pending.1.abs() < 0.01 {
+                state.pending = (0.0, 0.0);
+            }
+            step
+        };
+        if step.0 == 0.0 && step.1 == 0.0 {
+            return;
+        }
+        
+        
+        self.agent_pointer = true;
+        self.mouse.add_motion(step.0, step.1);
+    }
+    
+    
+    
+    pub(super) fn ios_release_all(&mut self) {
+        let (held, stick) = {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            if state.held.is_empty() && state.stick.is_none() && state.look.is_none() {
+                return;
+            }
+            let held = std::mem::take(&mut state.held);
+            let stick = state.stick.is_some() || state.knob != state.origin;
+            state.stick = None;
+            state.look = None;
+            state.slide = None;
+            state.drag = None;
+            state.pending = (0.0, 0.0);
+            state.knob = state.layout.as_ref().map_or((0.0, 0.0), |l| l.stick);
+            (held, stick)
+        };
+        if stick {
+            self.ios_stick(0.0, 0.0);
+        }
+        for (_, button) in held {
+            self.ios_button(button, false);
+        }
+        self.agent_pointer = false;
+    }
+    
+    pub(super) fn ios_release(&mut self, id: u64) {
+        let (stick, button, look) = {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            let stick = state.stick == Some(id);
+            if stick {
+                state.stick = None;
+                state.knob = state.layout.as_ref().map_or((0.0, 0.0), |l| l.stick);
+            }
+            let look = state.look == Some(id);
+            if look {
+                state.look = None;
+            }
+            if state.slide.is_some_and(|(finger, _, _)| finger == id) {
+                state.slide = None;
+            }
+            let button = state
+                .held
+                .iter()
+                .position(|(finger, _)| *finger == id)
+                .map(|index| state.held.remove(index).1);
+            (stick, button, look)
+        };
+        if stick {
+            self.ios_stick(0.0, 0.0);
+        }
+        if let Some(button) = button {
+            self.ios_button(button, false);
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            state
+                .latched
+                .push((button, std::time::Instant::now() + LATCH));
+        }
+        if look {
+            
+            let _ = self.flush_look(0.5);
+            self.agent_pointer = false;
+        }
+    }
+    
+    pub(super) fn draw_touch_controls(&mut self, batch: &mut horizon_client::hud::HudBatch) {
+        let atlas = &self.gui.atlas;
+        let (layout, knob, held) = {
+            let mut state = touch().lock().unwrap_or_else(|poison| poison.into_inner());
+            let Some(layout) = state.layout.clone() else {
+                return;
+            };
+            let now = std::time::Instant::now();
+            state.latched.retain(|(_, until)| *until > now);
+            let mut held: Vec<Button> = state.held.iter().map(|(_, button)| *button).collect();
+            held.extend(state.latched.iter().map(|(button, _)| *button));
+            let mut layout = layout;
+            layout.touch = state.mark;
+            layout.edit = state.edit;
+            layout.debug = state.debug || state.edit;
+            let knob = if layout.edit { layout.stick } else { state.knob };
+            (layout, knob, held)
+        };
+        touch_hud::paint(batch, atlas, &layout, knob, |button| held.contains(&button));
+        
+        
+        self.flush_look(0.5);
+    }
+}
