+use horizon_client_render::touch_hud::{self, Button, Layout};
+use std::sync::{Mutex, OnceLock};
+
+
+#[derive(Default)]
+struct Touch {
+    
+    layout: Option<Layout>,
+    
+    stick: Option<u64>,
+    origin: (f32, f32),
+    
+    look: Option<u64>,
