+                (width as f32 / scale).ceil(),
+                (height as f32 / scale).ceil(),
+            )
+            .as_ref(),
+        );
+        
+        
+        if !matches!(phase, TouchPhase::Moved) {
+            let share_x = gui_x / layout.width;
+            let share_y = gui_y / layout.height;
+            log::info!(
+                "Horizon: touch {id} {phase:?} gui {gui_x:.0},{gui_y:.0} of {width}x{height} (share {share_x:.3},{share_y:.3}) scale {scale}"
+            );
+        }
