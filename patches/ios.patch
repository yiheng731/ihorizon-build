+                        drop(state);
+                        self.ios_look(f64::from(dx), f64::from(dy));
+                        return;
+                    }
+                }
+                if state.stick == Some(id) {
+                    let (dx, dy) = (gui_x - state.origin.0, gui_y - state.origin.1);
+                    let length = (dx * dx + dy * dy).sqrt();
+                    let reach = layout.stick_radius;
+                    let (kx, ky) = if length > reach {
+                        (dx * reach / length, dy * reach / length)
+                    } else {
+                        (dx, dy)
+                    };
