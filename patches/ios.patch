+#[must_use]
+pub fn default_file(width: f32, height: f32) -> String {
+    if !BAKED.is_empty() {
+        return BAKED.to_owned();
+    }
+    let mut places = std::collections::BTreeMap::new();
+    let layout = layout(width, height);
+    let share = |x: f32, y: f32| [x / layout.width, y / layout.height];
+    for (button, rect) in layout.buttons {
+        let (x, y) = rect.centre();
+        let [x, y] = share(x, y);
+        places.insert(
+            key(button).to_owned(),
+            [x.clamp(0.0, 1.0), y.clamp(0.0, 1.0)],
+        );
+    }
+    let [sx, sy] = share(layout.stick.0, layout.stick.1);
+    let doc = serde_json::json!({
+        "button_size": BUTTON,
+        "stick_size": STICK_PAD,
+        "knob_size": STICK_KNOB,
+        "stick": [sx, sy],
+        "hotbar": [0.5, 1.0],
+        "look_from": 0.34,
+        "buttons": places,
+    });
+    serde_json::to_string_pretty(&doc).unwrap_or_default()
+}
+
+impl Layout {
+    
+    
+    pub fn button_at(&self, x: f32, y: f32) -> Option<Button> {
+        self.buttons
+            .iter()
+            .find(|(_, rect)| rect.contains(x, y))
+            .map(|(button, _)| *button)
+    }
+    
+    
+    #[must_use]
+    
+    
+    
+    pub fn toggle(&self) -> Rect {
+        Rect {
+            x0: 0.0,
+            y0: 0.0,
+            x1: 0.0,
+            y1: 0.0,
+        }
+    }
+    
+    
+    #[must_use]
+    pub fn handle_at(&self, x: f32, y: f32) -> Option<Handle> {
+        if let Some(button) = self.button_at(x, y) {
+            return Some(Handle::Button(button));
+        }
+        let (sx, sy) = self.stick;
+        let half = self.pad * 0.5;
+        if (x - sx).abs() <= half && (y - sy).abs() <= half {
+            return Some(Handle::Stick);
+        }
+        self.hotbar.contains(x, y).then_some(Handle::Hotbar)
+    }
+    
+    pub fn move_handle(&mut self, handle: Handle, x: f32, y: f32) {
+        let (x, y) = (x.clamp(0.0, self.width), y.clamp(0.0, self.height));
+        match handle {
+            Handle::Stick => {
+                self.stick = (x, y);
+            }
+            Handle::Button(button) => {
+                let side = self
+                    .buttons
+                    .iter()
+                    .find(|(slot, _)| *slot == button)
+                    .map_or(44.0, |(_, rect)| rect.x1 - rect.x0);
+                if let Some((_, rect)) = self.buttons.iter_mut().find(|(slot, _)| *slot == button) {
+                    *rect = Rect {
+                        x0: x - side * 0.5,
+                        y0: y - side * 0.5,
+                        x1: x + side * 0.5,
+                        y1: y + side * 0.5,
+                    };
+                }
+            }
+            Handle::Hotbar => {
+                
+                let half = (self.hotbar.x1 - self.hotbar.x0) * 0.5;
+                let height = self.hotbar.y1 - self.hotbar.y0;
+                self.hotbar = Rect {
+                    x0: x - half,
+                    y0: y - height,
+                    x1: x + half,
+                    y1: y,
+                };
+            }
+        }
+    }
+    
+    #[must_use]
+    pub fn file(&self) -> String {
+        let share = |x: f32, y: f32| [x / self.width, y / self.height];
+        let mut places = std::collections::BTreeMap::new();
+        for (button, rect) in self.buttons {
+            let (x, y) = rect.centre();
+            let [x, y] = share(x, y);
+            places.insert(key(button).to_owned(), [x, y]);
+        }
+        let [sx, sy] = share(self.stick.0, self.stick.1);
+        let [hx, hy] = share(
+            (self.hotbar.x0 + self.hotbar.x1) * 0.5,
+            self.hotbar.y1,
+        );
+        let mut sides = std::collections::BTreeMap::new();
+        for (button, rect) in self.buttons {
+            sides.insert(key(button).to_owned(), (rect.x1 - rect.x0).round());
+        }
+        let doc = serde_json::json!({
+            "button_size": (self.buttons[0].1.x1 - self.buttons[0].1.x0).round(),
+            "buttons_size": sides,
+            "stick_size": self.pad.round(),
+            "knob_size": self.knob.round(),
+            "stick": [sx, sy],
+            "hotbar": [hx, hy],
+            "look_from": self.look.x0 / self.width,
+            "buttons": places,
+            "debug": self.debug,
+            "edit": self.edit,
+        });
+        serde_json::to_string_pretty(&doc).unwrap_or_default()
+    }
+    
+    pub fn on_stick(&self, x: f32, y: f32) -> bool {
+        x < self.look.x0 && y > self.height * 0.35
+    }
+    
+    pub fn hotbar_slot(&self, x: f32, y: f32) -> Option<usize> {
+        if !self.hotbar.contains(x, y) {
+            return None;
+        }
+        let slot = ((x - self.hotbar.x0) / (HOTBAR_WIDTH / 9.0)) as i32;
+        Some(slot.clamp(0, 8) as usize)
+    }
+}
