 /// What `pick_adapter` knows of one of a backend's adapters.
+/// The size a surface is configured at: what the window reports, except on iOS, where winit
+/// reports 16:9 numbers that are not the screen — `inner_size` came back 2368x1398 and
+/// `outer_size` 2560x1440 on an iPhone 11, whose screen is 1792x828. There the app measures
+/// `UIScreen` before it starts the client and passes the answer in `HORIZON_WINDOW`.
+pub(super) fn window_size(window: &winit::window::Window) -> winit::dpi::PhysicalSize<u32> {
+    let reported = window.inner_size();
+    #[cfg(target_os = "ios")]
+    if let Some(size) = from_the_app() {
+        return size;
+    }
+    reported
+}
+
+/// `HORIZON_WINDOW` as `WIDTHxHEIGHT`, or nothing when it is absent or malformed.
+#[cfg(target_os = "ios")]
+fn from_the_app() -> Option<winit::dpi::PhysicalSize<u32>> {
+    let text = std::env::var("HORIZON_WINDOW").ok()?;
+    let (width, height) = text.split_once('x')?;
+    Some(winit::dpi::PhysicalSize::new(
+        width.parse().ok()?,
+        height.parse().ok()?,
+    ))
+}
