diff --git a/crates/horizon-threads/Cargo.toml b/crates/horizon-threads/Cargo.toml
index 53ae291..879d443 100644
--- a/crates/horizon-threads/Cargo.toml
+++ b/crates/horizon-threads/Cargo.toml
@@ -6,10 +6,15 @@ license.workspace = true
 rust-version.workspace = true
 description = "Scheduling hints for the game's threads and its allocator, and the other OS calls the crates that forbid unsafe code can't make"
 
-[dependencies]
+# iOS has no mimalloc: the game allocator there is the system one, so the crate is not built at all.
+[target.'cfg(not(target_os = "ios"))'.dependencies]
 mimalloc = { version = "0.1.52", default-features = false }
 libmimalloc-sys = { version = "0.1.49", default-features = false, features = ["extended"] }
 
+[dependencies]
+# `big_stack`: a frame bigger than the stack a platform gives the main thread (iOS gives 1 MiB).
+stacker = "0.1"
+
 [target.'cfg(any(target_vendor = "apple", target_os = "linux", target_os = "android"))'.dependencies]
 libc = "0.2"
 
diff --git a/crates/horizon-threads/src/big_stack.rs b/crates/horizon-threads/src/big_stack.rs
new file mode 100644
index 0000000..91e532c
--- /dev/null
+++ b/crates/horizon-threads/src/big_stack.rs
@@ -0,0 +1,18 @@
+//! Work that needs a desktop main thread's stack, on a platform whose main thread has far less.
+
+/// More than a desktop gives its main thread: a renderer's frame did not fit in eight mebibytes
+/// either, so this is a reservation rather than a measured size.
+const DESKTOP_MAIN_STACK: usize = 128 * 1024 * 1024;
+
+/// Runs `build` with a desktop main thread's stack behind it, and returns what it returned.
+///
+/// iOS runs the game on the main thread, and there the main thread has about one megabyte of
+/// stack: building a renderer is a future larger than that, and on an iPhone 11 the app died in
+/// the building function's own prologue, on the main thread's stack guard, before it drew anything.
+/// The work stays on the main thread it was called from: the surface it builds comes from the
+/// window's view, and UIKit is main-thread only.
+pub fn on_a_big_stack<T>(build: impl FnOnce() -> T) -> T {
+    // `grow`, not `maybe_grow`: a renderer's frame is larger than the whole main thread stack on
+    // an iPhone, and what the platform reports as left of that stack is not this thread's.
+    stacker::grow(DESKTOP_MAIN_STACK, build)
+}
