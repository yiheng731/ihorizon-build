diff --git a/crates/horizon-client-input/Cargo.toml b/crates/horizon-client-input/Cargo.toml
index 4454e94..2bb43ea 100644
--- a/crates/horizon-client-input/Cargo.toml
+++ b/crates/horizon-client-input/Cargo.toml
@@ -10,6 +10,11 @@ description = "The client's input layer: key bindings and their names, mouse, co
 horizon-client-core = { path = "../horizon-client-core" }
 winit = "0.30.13"
 png = "0.18"
+arboard = { version = "3.6.1", default-features = false }
+
+[target.'cfg(target_os = "linux")'.dependencies]
+# `wayland-data-control` pulls wl-clipboard-rs, whose cfg is `all(unix, not(macos, android, emscripten))`
+# — iOS counts as unix, so the feature drags wayland-backend onto iOS and it fails on Linux-only rustix APIs.
 arboard = { version = "3.6.1", default-features = false, features = ["wayland-data-control"] }
 
 [dev-dependencies]
